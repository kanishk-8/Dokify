# Dokify App Environment Variables Example
# Copy this file to .env.development, .env.production, etc. and fill in your values

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for your Dokify backend API
# Development: Use localhost or your computer's IP for physical device testing
API_BASE_URL=http://localhost:7860
EXPO_PUBLIC_API_URL=http://localhost:7860

# For testing on physical device, replace with your computer's IP address:
# API_BASE_URL=http://192.168.1.100:7860
# EXPO_PUBLIC_API_URL=http://192.168.1.100:7860

# Production: Use your deployed Hugging Face Space URL
# API_BASE_URL=https://your-username-dokify-audiobook-generator.hf.space
# EXPO_PUBLIC_API_URL=https://your-username-dokify-audiobook-generator.hf.space

# =============================================================================
# App Configuration
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Debug mode (true/false)
EXPO_PUBLIC_DEBUG=true

# Logging level (debug, info, warn, error)
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable/disable logging
EXPO_PUBLIC_ENABLE_LOGGING=true

# =============================================================================
# API Timeouts (in milliseconds)
# =============================================================================

# General API request timeout
EXPO_PUBLIC_API_TIMEOUT=30000

# File upload timeout (longer for PDF uploads)
EXPO_PUBLIC_UPLOAD_TIMEOUT=300000

# Job status polling interval
EXPO_PUBLIC_POLLING_INTERVAL=10000

# =============================================================================
# File Upload Configuration
# =============================================================================

# Maximum file size in bytes (50MB default)
EXPO_PUBLIC_MAX_FILE_SIZE=52428800

# Supported file formats (comma-separated)
EXPO_PUBLIC_SUPPORTED_FORMATS=pdf

# Maximum pages allowed in PDF
EXPO_PUBLIC_MAX_PDF_PAGES=500

# =============================================================================
# Feature Flags
# =============================================================================

# Enable analytics tracking
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Enable crash reporting
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# Enable offline mode
EXPO_PUBLIC_ENABLE_OFFLINE=true

# Enable background sync
EXPO_PUBLIC_ENABLE_BACKGROUND_SYNC=true

# =============================================================================
# Audio Configuration
# =============================================================================

# Default audio format (wav, mp3)
EXPO_PUBLIC_DEFAULT_AUDIO_FORMAT=wav

# Enable audio preview
EXPO_PUBLIC_ENABLE_AUDIO_PREVIEW=true

# Audio player buffer size
EXPO_PUBLIC_AUDIO_BUFFER_SIZE=8192

# =============================================================================
# UI Configuration
# =============================================================================

# App theme (light, dark, auto)
EXPO_PUBLIC_DEFAULT_THEME=auto

# Enable haptic feedback
EXPO_PUBLIC_ENABLE_HAPTICS=true

# Animation duration (in milliseconds)
EXPO_PUBLIC_ANIMATION_DURATION=300

# =============================================================================
# Storage Configuration
# =============================================================================

# Local storage keys prefix
EXPO_PUBLIC_STORAGE_PREFIX=dokify_

# Cache duration for audiobooks (in milliseconds)
EXPO_PUBLIC_CACHE_DURATION=86400000

# Maximum cached audiobooks
EXPO_PUBLIC_MAX_CACHED_AUDIOBOOKS=10

# =============================================================================
# Development Only
# =============================================================================

# Enable React Native Flipper (development only)
FLIPPER_ENABLED=true

# Enable Metro bundler logging
EXPO_PUBLIC_METRO_LOGGING=true

# Enable performance monitoring
EXPO_PUBLIC_PERFORMANCE_MONITORING=true

# =============================================================================
# Optional: Third-party Services
# =============================================================================

# Analytics service API key (if using analytics)
# EXPO_PUBLIC_ANALYTICS_API_KEY=your_analytics_key_here

# Crash reporting service API key (if using crash reporting)
# EXPO_PUBLIC_CRASH_REPORTING_API_KEY=your_crash_reporting_key_here

# Firebase configuration (if using Firebase)
# EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
# EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# =============================================================================
# Notes:
# =============================================================================
#
# 1. Variables prefixed with EXPO_PUBLIC_ are available in your React Native code
# 2. Variables without EXPO_PUBLIC_ are only available during build time
# 3. Never commit sensitive API keys or secrets to version control
# 4. For production builds, create .env.production with production values
# 5. For development, create .env.development with local development values
#
# Usage in React Native:
# const apiUrl = process.env.EXPO_PUBLIC_API_URL;
# const debug = process.env.EXPO_PUBLIC_DEBUG === 'true';
#
